# Dependencies
node_modules/

# Build output
dist/
build/
*.ipk

# Generated at build time from the deployment tracker
version.json

# Populated by scripts/set-config.sh from SSM; template is committed
app/src/secrets.json

# Planning
PLAN.md

# CDK
cdk.out/
*.out/

# Android — Gradle build output and the local SDK path; the wrapper itself
# (gradlew, gradle/wrapper/*) is committed so builds are reproducible.
android/.gradle/
android/local.properties
android/build/
android/*/build/
android/*/.cxx/
# Copied in by scripts/install-android.sh from app/dist; never hand-edited.
android/app/src/main/assets/www/

# Coverage
coverage/
lcov.info

# OS / editor
.DS_Store
.idea/
.vscode/

# Python
__pycache__/

# Furry Sad cat exports: 43-225 MB each, too big for GitHub. Rebuilt from
# sad-cat-fur.blend; backed up on Leia at share/naktv/test-models/sad-cat/.
tools/print-video/test-models/sad-cat/sad-cat-*.obj

# Apple — the Xcode project is generated from apple/project.yml by xcodegen,
# and www/ is copied in from app/dist by scripts/install-apple.sh.
apple/NakTV.xcodeproj/
apple/www/
apple/build/
apple/Config/Local.xcconfig
# Written by xcodegen from project.yml's info/entitlements properties; edit
# those, not these.
apple/iOS/Info.plist
apple/macOS/Info.plist
apple/macOS/NakTV.entitlements
