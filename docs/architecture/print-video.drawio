<mxfile host="drawio">
  <diagram id="print-video" name="Print video">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1060" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;NakTV resin print: live to the TV, archived separately, rendered for YouTube&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="printer" value="&lt;b&gt;Elegoo Mars 5 Ultra&lt;/b&gt;&lt;br&gt;172.29.0.37&lt;br&gt;&lt;br&gt;camera: RTSP :554&lt;br&gt;status + print file: SDCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="phone" value="&lt;b&gt;Spotify&lt;/b&gt;&lt;br&gt;phone / laptop picks&lt;br&gt;&quot;NakTV&quot; in Connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="library" value="&lt;b&gt;Leia: CC0 / CC BY music library&lt;/b&gt;&lt;br&gt;fetch_fma.py (NAKTV-25), indexed by Plex&lt;br&gt;tracks.json: artist, title, licence, source" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="210" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="rey" value="&lt;b&gt;Rey&lt;/b&gt; (always on, Ansible: home-infra rey/ansible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="60" width="780" height="740" as="geometry"/>
        </mxCell>

        <mxCell id="cthulhu" value="&lt;b&gt;cthulhu&lt;/b&gt; (compose, :9120)&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• camera service: printer RTSP → MJPEG :9121&lt;br&gt;• /api/status, /api/ws: phase, layer, times&lt;br&gt;• fetches the .goo off the printer&lt;br&gt;• /api/print/layer: decodes a layer,&lt;br&gt;&amp;nbsp;&amp;nbsp;scaled to 852×432 PNG&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="310" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="go2rtc" value="&lt;b&gt;go2rtc&lt;/b&gt; :1984&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• &lt;i&gt;resin&lt;/i&gt;: MJPEG → H.264&lt;br&gt;• &lt;i&gt;resin_av&lt;/i&gt;: the same + the music (AAC)&lt;br&gt;&amp;nbsp;&amp;nbsp;one stream: webOS allows one media element&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="320" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="librespot" value="&lt;b&gt;librespot + pcm-pacer&lt;/b&gt;&lt;br&gt;Spotify Connect endpoint, paced PCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="libplayer" value="&lt;b&gt;library-player + pcm-pacer&lt;/b&gt;&lt;br&gt;random tracks, logs each play&lt;br&gt;&lt;i&gt;NAKTV-26, in progress&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="610" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="switch" value="&lt;b&gt;music-switch&lt;/b&gt;&lt;br&gt;Spotify or library&lt;br&gt;&lt;i&gt;NAKTV-26&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="520" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="nowplaying" value="&lt;b&gt;now-playing server&lt;/b&gt; :1985&lt;br&gt;artist + track for the overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="720" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="capture" value="&lt;b&gt;Capture&lt;/b&gt; (armed by wait-for-print.sh)&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• record-print.sh: resin_av video, copied&lt;br&gt;• log-status.py: /api/status, 1 Hz&lt;br&gt;• log-status-events.py: /api/ws, to the ms&lt;br&gt;• save-layers.sh: the .goo + every layer PNG&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="recordings" value="&lt;b&gt;~/resin-recordings&lt;/b&gt;: stored separately&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;PREFIX-partNN.mkv &amp;nbsp;(camera only, no audio)&lt;br&gt;PREFIX-status.jsonl, -status-events.jsonl&lt;br&gt;PREFIX-layers/NNNN.png &amp;nbsp;(852×432)&lt;br&gt;&lt;b&gt;PREFIX.goo&lt;/b&gt; &amp;nbsp;(8520×4320, every exact layer)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="780" y="430" width="270" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="tv" value="&lt;b&gt;LG B3, webOS 23&lt;/b&gt;&lt;br&gt;NakTV&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• one &amp;lt;video&amp;gt;: camera + music&lt;br&gt;• overlay: status, layer, times&lt;br&gt;• layer image, full detail&lt;br&gt;• now playing&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1160" y="80" width="250" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="phi" value="&lt;b&gt;phi&lt;/b&gt; (M5 Pro): render.py, ~10× real time&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• camera, scaled to 1080p&lt;br&gt;• NakTV overlay burned in&lt;br&gt;• layer panel: &lt;b&gt;75% detail + 1 px blur&lt;/b&gt;&lt;br&gt;• CC0 / CC BY soundtrack, replacing&lt;br&gt;&amp;nbsp;&amp;nbsp;whatever the TV was playing&lt;br&gt;• description.txt: credits + chapters&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="420" width="270" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="archive" value="&lt;b&gt;Luke / Leia&lt;/b&gt;&lt;br&gt;archive, at leisure" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1160" y="680" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="public" value="&lt;b&gt;Public&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#b85450;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontColor=#b85450;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="390" width="250" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="youtube" value="&lt;b&gt;YouTube&lt;/b&gt;&lt;br&gt;MP4, 1920×1080&lt;br&gt;&lt;br&gt;the only layer detail that&lt;br&gt;leaves the house: the&lt;br&gt;blurred 75% panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1500" y="440" width="210" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Why it's split this way.&lt;/b&gt; The TV gets everything live and at full detail. The capture keeps each ingredient separate (camera video with no audio, status logs, the exact print file) so a video can be rebuilt later with different choices: a fuzzier layer panel, and music that is licensed for YouTube. The exact layers (the .goo) are all it takes to reprint the model byte for byte, so they never leave the house." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="1050" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;blue: live pipeline&lt;br&gt;green: music&lt;br&gt;purple: record and render&lt;br&gt;dashed: in progress (NAKTV-26)&lt;br&gt;red: public" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#666666;rounded=1;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1400" y="830" width="220" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="RTSP (camera)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.3;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="printer" target="cthulhu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="SDCP: status, .goo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.75;entryX=0;entryY=0.75;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="printer" target="cthulhu">
          <mxGeometry relative="1" as="geometry"/>
