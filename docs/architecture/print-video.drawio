        <mxCell id="e4" value="resin_av: MSE over WebSocket&lt;br&gt;H.264 + AAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.25;entryX=0;entryY=0.35;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="go2rtc" target="tv">
          <mxGeometry relative="1" as="geometry"/>
