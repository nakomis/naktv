        <mxCell id="e6" value="Connect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="phone" target="librespot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="random tracks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="library" target="libplayer">
          <mxGeometry relative="1" as="geometry"/>
