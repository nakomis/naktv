{
  "name": "naktv-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "prebuild": "../scripts/set-config.sh",
    "build": "tsc -b && vite build && node scripts/write-appinfo.mjs",
    "package": "pnpm run build && ares-package dist -o build",
    "install-tv": "../scripts/install-tv.sh",
    "pretest": "../scripts/set-config.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pretypecheck": "../scripts/set-config.sh",
    "typecheck": "tsc -b",
    "prelint": "../scripts/set-config.sh",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@webos-tools/cli": "^3.2.6",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
